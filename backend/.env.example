# Django 后端环境变量示例
# 使用方法：复制本文件为 .env（与 manage.py 同级），填入本机实际值。
# .env 已在 .gitignore 中，不会被提交。

# Django 密钥（必填）。生成方式：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 调试模式：true / false
DJANGO_DEBUG=true

# 允许的主机，逗号分隔，开发环境可用 *
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL / TimescaleDB（Docker 本地库）
POSTGRES_DB=eeqsDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432

# Celery broker（Redis）
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# 水文模型脚本绝对路径（按需配置，不配则用 settings 里的默认值）
# HYDROLOGY_MODEL_SCRIPT_PATH=
